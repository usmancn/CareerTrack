@model CareerTrack.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="auth-modern-container">
    <div class="auth-kinetic-map" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
    </div>

    <div class="auth-storyboard" aria-hidden="true">
        <div class="story-stage story-stage-a">
            <i class="bi bi-person-plus"></i>
            <span>Kayıt</span>
        </div>
        <div class="story-stage story-stage-b">
            <i class="bi bi-diagram-3"></i>
            <span>Rol</span>
        </div>
        <div class="story-stage story-stage-c">
            <i class="bi bi-stars"></i>
            <span>Başlangıç</span>
        </div>
    </div>
    
    <div class="auth-modern-card" style="max-height: 95vh; overflow-y: auto;">
        <div class="auth-modern-header">
            <div class="logo-wrapper">
                <i class="bi bi-person-plus-fill glow-icon"></i>
            </div>
            <h2>Aramıza Katılın</h2>
            <p>Kariyerinizde yeni bir sayfa açmak için ilk adımı atın.</p>
        </div>

        <form asp-action="Register" method="post" id="registerForm" class="premium-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="form-group mb-4">
                <label asp-for="Role" class="form-label">Hesap Türü</label>
                <div class="d-grid gap-2" style="grid-template-columns: 1fr 1fr;">
                    <label class="btn btn-outline-primary rounded-3 py-3">
                        <input asp-for="Role" type="radio" value="@AppRoles.Student" class="btn-check" checked="@(Model.Role == AppRoles.Student)" />
                        <i class="bi bi-mortarboard me-1"></i> Öğrenci
                    </label>
                    <label class="btn btn-outline-success rounded-3 py-3">
                        <input asp-for="Role" type="radio" value="@AppRoles.Employer" class="btn-check" checked="@(Model.Role == AppRoles.Employer)" />
                        <i class="bi bi-building me-1"></i> İşveren
                    </label>
                </div>
                <span asp-validation-for="Role" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="FullName" class="form-label">Ad Soyad</label>
                <div class="input-glass-wrapper">
                    <i class="bi bi-person input-icon"></i>
                    <input asp-for="FullName" class="glass-input-premium" placeholder="Ad Soyad" />
                </div>
                <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Email" class="form-label">E-posta Adresi</label>
                <div class="input-glass-wrapper">
                    <i class="bi bi-envelope input-icon"></i>
                    <input asp-for="Email" class="glass-input-premium" placeholder="ornek@email.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="form-group mb-4" id="departmentField">
                <label asp-for="Department" class="form-label">Bölüm / Departman</label>
                <div class="input-glass-wrapper">
                    <i class="bi bi-mortarboard input-icon"></i>
                    <input asp-for="Department" class="glass-input-premium" placeholder="Bilgisayar Mühendisliği" />
                </div>
            </div>

            <div id="employerFields" class="d-none">
                <div class="form-group mb-4">
                    <label asp-for="EmployerCompanyMode" class="form-label">Şirket Bilgisi</label>
                    <select asp-for="EmployerCompanyMode" class="glass-input-premium" id="employerCompanyMode">
                        <option value="Existing">Mevcut şirketi seç</option>
                        <option value="New">Yeni şirket gir</option>
                    </select>
                    <span asp-validation-for="EmployerCompanyMode" class="text-danger small mt-1 d-block"></span>
                </div>

                <div id="existingCompanyFields" class="form-group mb-4">
                    <label asp-for="CompanyId" class="form-label">Mevcut Şirket</label>
                    <select asp-for="CompanyId" asp-items="Model.Companies" class="glass-input-premium">
                        <option value="">-- Şirket seçiniz --</option>
                    </select>
                    <span asp-validation-for="CompanyId" class="text-danger small mt-1 d-block"></span>
                </div>

                <div id="newCompanyFields" class="d-none">
                    <div class="form-group mb-4">
                        <label asp-for="CompanyName" class="form-label">Şirket Adı</label>
                        <div class="input-glass-wrapper">
                            <i class="bi bi-building input-icon"></i>
                            <input asp-for="CompanyName" class="glass-input-premium" placeholder="Örn: ABC Yazılım A.Ş." />
                        </div>
                        <span asp-validation-for="CompanyName" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label asp-for="CompanySector" class="form-label">Sektör</label>
                        <div class="input-glass-wrapper">
                            <i class="bi bi-diagram-3 input-icon"></i>
                            <input asp-for="CompanySector" class="glass-input-premium" placeholder="Örn: Bilgi Teknolojileri" />
                        </div>
                        <span asp-validation-for="CompanySector" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label asp-for="CompanyLocation" class="form-label">Konum</label>
                        <div class="input-glass-wrapper">
                            <i class="bi bi-geo-alt input-icon"></i>
                            <input asp-for="CompanyLocation" class="glass-input-premium" placeholder="Örn: İstanbul, Türkiye" />
                        </div>
                        <span asp-validation-for="CompanyLocation" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="Password" class="form-label">Şifre</label>
                        <div class="input-glass-wrapper">
                            <i class="bi bi-lock input-icon"></i>
                            <input asp-for="Password" class="glass-input-premium" placeholder="En az 6" type="password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="ConfirmPassword" class="form-label">Şifre Tekrar</label>
                        <div class="input-glass-wrapper">
                            <i class="bi bi-shield-lock input-icon"></i>
                            <input asp-for="ConfirmPassword" class="glass-input-premium" placeholder="Tekrar girin" type="password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn-premium-submit w-100 mb-4 mt-2">
                <span>Kayıt Ol</span>
                <i class="bi bi-person-plus-fill"></i>
            </button>
        </form>
        
        <div class="form-footer mt-4 text-center">
            <p class="text-muted">Zaten hesabınız var mı? <a asp-action="Login" class="text-primary-glow fw-bold">Giriş Yap</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScripts" />
    <script>
        const employerFields = document.getElementById('employerFields');
        const companyMode = document.getElementById('employerCompanyMode');
        const existingCompanyFields = document.getElementById('existingCompanyFields');
        const newCompanyFields = document.getElementById('newCompanyFields');

        function updateRegisterFields() {
            const selectedRole = document.querySelector('input[name="Role"]:checked')?.value;
            const isEmployer = selectedRole === '@AppRoles.Employer';
            employerFields.classList.toggle('d-none', !isEmployer);

            const isNewCompany = companyMode.value === 'New';
            existingCompanyFields.classList.toggle('d-none', !isEmployer || isNewCompany);
            newCompanyFields.classList.toggle('d-none', !isEmployer || !isNewCompany);
        }

        document.querySelectorAll('input[name="Role"]').forEach((input) => {
            input.addEventListener('change', updateRegisterFields);
        });
        companyMode.addEventListener('change', updateRegisterFields);
        updateRegisterFields();
    </script>
}
