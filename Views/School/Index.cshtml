@model CareerTrack.Models.ViewModels.SchoolDashboardViewModel
@{
    ViewData["Title"] = "Okul Paneli";
    var processedDailyLogs = Math.Max(0, Model.TotalDailyLogs - Model.PendingDailyLogs);
    var schoolFlowTotal = Math.Max(1, Model.TotalDailyLogs);
}

<!-- İstatistik Kartları -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-mortarboard"></i></div>
            <div class="stat-value count-anim">@Model.TotalStudents</div>
            <div class="stat-label">Öğrenci</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card stat-orange">
            <div class="stat-icon"><i class="bi bi-send"></i></div>
            <div class="stat-value count-anim">@Model.TotalApplications</div>
            <div class="stat-label">Başvuru</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card stat-red">
            <div class="stat-icon"><i class="bi bi-journal-x"></i></div>
            <div class="stat-value count-anim">@Model.PendingDailyLogs</div>
            <div class="stat-label">Onay Bekleyen</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card stat-green">
            <div class="stat-icon"><i class="bi bi-journal-check"></i></div>
            <div class="stat-value count-anim">@Model.TotalDailyLogs</div>
            <div class="stat-label">Toplam Günlük</div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4 dashboard-graphs">
    <div class="col-lg-7">
        <div class="chart-card h-100" data-chart-card>
            <div class="chart-header">
                <div>
                    <span class="chart-kicker">Okul koordinasyonu</span>
                    <h3>Öğrenci ve Başvuru Kapsamı</h3>
                </div>
                <i class="bi bi-clipboard-data"></i>
            </div>
            <div class="chart-bars" data-chart-bars>
                <div class="chart-bar-row" data-chart-value="@Model.TotalStudents" data-bs-toggle="tooltip" data-bs-title="Okul tarafından izlenebilen toplam öğrenci">
                    <span>Öğrenci</span>
                    <div class="chart-bar-track"><span class="chart-bar-fill"></span></div>
                    <strong data-chart-number>@Model.TotalStudents</strong>
                </div>
                <div class="chart-bar-row" data-chart-value="@Model.TotalApplications" data-bs-toggle="tooltip" data-bs-title="Sistemdeki toplam staj başvurusu">
                    <span>Başvuru</span>
                    <div class="chart-bar-track"><span class="chart-bar-fill"></span></div>
                    <strong data-chart-number>@Model.TotalApplications</strong>
                </div>
                <div class="chart-bar-row" data-chart-value="@Model.TotalDailyLogs" data-bs-toggle="tooltip" data-bs-title="Öğrencilerin oluşturduğu toplam staj günlüğü">
                    <span>Günlük</span>
                    <div class="chart-bar-track"><span class="chart-bar-fill"></span></div>
                    <strong data-chart-number>@Model.TotalDailyLogs</strong>
                </div>
                <div class="chart-bar-row" data-chart-value="@Model.PendingDailyLogs" data-bs-toggle="tooltip" data-bs-title="Okul onayı bekleyen günlükler">
                    <span>Onay bekleyen</span>
                    <div class="chart-bar-track"><span class="chart-bar-fill"></span></div>
                    <strong data-chart-number>@Model.PendingDailyLogs</strong>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="chart-card h-100 chart-focus-card" data-chart-card>
            <div class="chart-header">
                <div>
                    <span class="chart-kicker">Onay yükü</span>
                    <h3>Günlük İnceleme Dengesi</h3>
                </div>
                <i class="bi bi-journal-check"></i>
            </div>
            <div class="chart-donut-wrap">
                <div class="chart-donut" data-chart-donut data-chart-value="@processedDailyLogs" data-chart-total="@schoolFlowTotal">
                    <div class="chart-donut-core">
                        <strong class="count-anim">@processedDailyLogs</strong>
                        <span>işlenmiş günlük</span>
                    </div>
                </div>
                <div class="pipeline-graph">
                    <div class="pipeline-step">
                        <i class="bi bi-hourglass-split"></i>
                        <strong>@Model.PendingDailyLogs</strong>
                        <span>Onay bekliyor</span>
                    </div>
                    <div class="pipeline-step">
                        <i class="bi bi-check2-circle"></i>
                        <strong>@processedDailyLogs</strong>
                        <span>İşlenmiş</span>
                    </div>
                    <div class="pipeline-step">
                        <i class="bi bi-person-lines-fill"></i>
                        <strong>@Model.Students.Count</strong>
                        <span>Takip listesi</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Onay Akışı -->
    <div class="col-lg-6">
        <div class="card-section">
            <div class="section-header">
                <span><i class="bi bi-journal-check me-2 text-primary"></i>Onay Akışı</span>
                <a asp-action="DailyLogs" class="see-all">Tümünü Gör</a>
            </div>
            <div class="p-0">
                @if (!Model.RecentDailyLogs.Any())
                {
                    <div class="empty-state"><i class="bi bi-inbox mb-2"></i><p>Henüz günlük yok</p></div>
                }
                @foreach (var log in Model.RecentDailyLogs)
                {
                    <div class="list-item">
                        <div class="list-item-icon">
                            <i class="bi bi-journal-text"></i>
                        </div>
                        <div class="list-item-body">
                            <div class="list-item-title">@log.Student?.FullName</div>
                            <div class="list-item-sub">@log.DayNumber. Gün • @log.LogDate.ToString("dd.MM.yyyy")</div>
                        </div>
                        @switch (log.Status)
                        {
                            case CareerTrack.Models.Enums.DailyLogStatus.EmployerApproved:
                                <span class="status-badge status-pending">İşlem Bekliyor</span>
                                break;
                            case CareerTrack.Models.Enums.DailyLogStatus.SchoolApproved:
                                <span class="status-badge status-offered">Onaylandı</span>
                                break;
                            case CareerTrack.Models.Enums.DailyLogStatus.SchoolRejected:
                                <span class="status-badge status-rejected">Revize İstendi</span>
                                break;
                            default:
                                <span class="status-badge status-inreview">@log.Status.ToString()</span>
                                break;
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Son Başvurular -->
    <div class="col-lg-6">
        <div class="card-section">
            <div class="section-header">
                <span><i class="bi bi-briefcase me-2 text-success"></i>Son Başvurular</span>
                <a asp-action="Applications" class="see-all">Tümünü Gör</a>
            </div>
            <div class="p-0">
                @if (!Model.RecentApplications.Any())
                {
                    <div class="empty-state"><i class="bi bi-send-slash mb-2"></i><p>Henüz başvuru yok</p></div>
                }
                @foreach (var app in Model.RecentApplications)
                {
                    <div class="list-item">
                        <div class="list-item-icon interview-icon">
                            <i class="bi bi-person"></i>
                        </div>
                        <div class="list-item-body">
                            <div class="list-item-title">@app.Student?.FullName</div>
                            <div class="list-item-sub">@app.Company?.Name • @app.Position</div>
                        </div>
                        <span class="status-badge status-@app.Status.ToString().ToLower()">
                            @(app.Status switch {
                                ApplicationStatus.SchoolPending => "Okul Onayı Bekliyor",
                                ApplicationStatus.SchoolRevision => "Revize İstendi",
                                ApplicationStatus.SchoolApproved => "Staj Devam Ediyor",
                                ApplicationStatus.PreScreening => "Ön Eleme",
                                ApplicationStatus.AptitudeTest => "Test",
                                ApplicationStatus.LanguageTest => "Dil Sınavı",
                                ApplicationStatus.Interview => "Mülakat",
                                ApplicationStatus.EmployerAccepted => "Kabul Edildi",
                                ApplicationStatus.Rejected => "Reddedildi",
                                ApplicationStatus.Completed => "Tamamlandı",
                                _ => app.Status.ToString()
                            })
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Öğrenci Listesi -->
<div class="row mt-4" id="ogrenci-listesi">
    <div class="col-12">
        <div class="table-card">
            <div class="section-header">
                <span><i class="bi bi-person-lines-fill me-2 text-info"></i>Öğrenci Takibi</span>
            </div>
            <div class="p-0">
                @if (Model.Students.Any())
                {
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Ad Soyad</th>
                                    <th>Bölüm</th>
                                    <th>E-posta</th>
                                    <th class="text-end">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in Model.Students)
                                {
                                    <tr>
                                        <td class="fw-semibold">@student.FullName</td>
                                        <td>@(student.Department ?? "—")</td>
                                        <td>@student.Email</td>
                                        <td class="text-end">
                                            <a asp-action="StudentDetail" asp-route-id="@student.UserId"
                                               class="btn btn-secondary-premium btn-sm py-2">
                                                <i class="bi bi-eye me-1"></i>Detay Görüntüle
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-person-x fs-1 d-block mb-3 opacity-30"></i>
                        <p class="mb-0">Henüz kayıtlı öğrenci yok.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
