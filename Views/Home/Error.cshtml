@{
    ViewData["Title"] = "Bir Hata Oluştu";
}

<div class="error-page">
    <div class="error-container glass-panel">
        <div class="error-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <h1>Bir Hata Oluştu</h1>
        <p>Üzgünüz, bir şeyler ters gitti. Lütfen sayfayı yenileyin veya daha sonra tekrar deneyin.</p>
        @if (ViewBag.RequestId != null)
        {
            <small class="text-muted">Hata Kodu: @ViewBag.RequestId</small>
        }
        <div class="mt-4">
            <a href="/" class="btn btn-primary">
                <i class="bi bi-house-fill me-2"></i>Ana Sayfaya Dön
            </a>
        </div>
    </div>
</div>

<style>
.error-page {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60vh;
}
.error-container {
    text-align: center;
    padding: 3rem;
    max-width: 500px;
}
.error-icon {
    font-size: 4rem;
    color: var(--danger, #ef4444);
    margin-bottom: 1.5rem;
}
</style>
