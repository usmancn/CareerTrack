@using CareerTrack.Models.Constants
@using Microsoft.AspNetCore.Identity
@inject SignInManager<CareerTrack.Models.Entities.ApplicationUser> SignInManager
@inject UserManager<CareerTrack.Models.Entities.ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — CareerTrack</title>
    <link rel="icon" href="~/favicon.ico" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CareerTrack.styles.css" asp-append-version="true" />

    @if (User.HasClaim("RequiresPasswordChange", "true") &&
         ViewContext.RouteData.Values["controller"]?.ToString() != "Profile")
    {
        <script>
            window.location.replace('/Profile/Settings');
        </script>
    }
</head>
<body>

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var isSchool = User.IsInRole(AppRoles.School);
    var isEmployer = User.IsInRole(AppRoles.Employer);
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var userInitial = string.IsNullOrWhiteSpace(currentUser?.FullName)
        ? "K"
        : currentUser.FullName.Trim().Substring(0, 1).ToUpper();
    var roleLabel = isAdmin ? "Admin" : isSchool ? "Okul" : isEmployer ? "İşveren" : "Öğrenci";
    var roleDescription = isAdmin ? "Sistem yönetimi" : isSchool ? "Koordinatör paneli" : isEmployer ? "Şirket paneli" : "Staj takip alanı";
    var roleClass = isAdmin ? "role-admin" : isSchool ? "role-school" : isEmployer ? "role-employer" : "role-student";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
    int pendingTodos = ViewBag.PendingTodos ?? 0;
    int upcomingInterviews = ViewBag.UpcomingInterviews ?? 0;

    <div class="app-shell @roleClass" data-motion-shell>
        <div class="motion-grid" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
        </div>

        <aside class="app-sidebar" id="sidebar" data-app-sidebar aria-label="Ana menü">
            <div class="sidebar-brand">
                <a asp-controller="Dashboard" asp-action="Index" class="brand-mark" aria-label="CareerTrack ana sayfa">
                    <span class="brand-icon">
                        <span class="brand-core">CT</span>
                    </span>
                    <span>
                        <strong>CareerTrack</strong>
                        <small>Süreç Stüdyosu</small>
                    </span>
                </a>
            </div>

            <div class="sidebar-user-card">
                <div class="user-avatar">@userInitial</div>
                <div class="user-info">
                    <div class="user-name">@currentUser?.FullName</div>
                    <div class="user-role">@roleLabel · @roleDescription</div>
                </div>
                <div class="user-flow" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>

            <nav class="sidebar-nav-wrapper">
                <div class="nav-section-label">Menü</div>
                <ul class="nav flex-column sidebar-nav">
                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Admin" && currentAction == "Index" ? "active" : "")"
                               asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Admin" && currentAction == "Users" ? "active" : "")"
                               asp-controller="Admin" asp-action="Users">
                                <i class="bi bi-person-gear"></i><span>Kullanıcı Rolleri</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Admin" && currentAction == "Applications" ? "active" : "")"
                               asp-controller="Admin" asp-action="Applications">
                                <i class="bi bi-kanban"></i><span>Tüm Başvurular</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Admin" && currentAction == "DailyLogs" ? "active" : "")"
                               asp-controller="Admin" asp-action="DailyLogs">
                                <i class="bi bi-journal-check"></i><span>Staj Günlükleri</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Admin" && currentAction == "Companies" ? "active" : "")"
                               asp-controller="Admin" asp-action="Companies">
                                <i class="bi bi-building"></i><span>Şirket Yönetimi</span>
                            </a>
                        </li>
                    }
                    else if (isSchool)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "School" && currentAction == "Index" ? "active" : "")"
                               asp-controller="School" asp-action="Index">
                                <i class="bi bi-grid-1x2"></i><span>Okul Paneli</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "School" && currentAction == "Applications" ? "active" : "")"
                               asp-controller="School" asp-action="Applications">
                                <i class="bi bi-clipboard-check"></i><span>Başvurular</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "School" && currentAction == "DailyLogs" ? "active" : "")"
                               asp-controller="School" asp-action="DailyLogs">
                                <i class="bi bi-journal-check"></i><span>Günlük Onayları</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "School" && (currentAction == "StudentDetail" || currentAction == "Students") ? "active" : "")"
                               asp-controller="School" asp-action="Students">
                                <i class="bi bi-person-lines-fill"></i><span>Öğrenci Takibi</span>
                            </a>
                        </li>
                    }
                    else if (isEmployer)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Employer" && currentAction == "Index" ? "active" : "")"
                               asp-controller="Employer" asp-action="Index">
                                <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Employer" && currentAction == "Postings" ? "active" : "")"
                               asp-controller="Employer" asp-action="Postings">
                                <i class="bi bi-megaphone"></i><span>İlanlarım</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Employer" && currentAction == "CreatePosting" ? "active" : "")"
                               asp-controller="Employer" asp-action="CreatePosting">
                                <i class="bi bi-plus-circle"></i><span>Yeni İlan</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Employer" && currentAction == "Applications" ? "active" : "")"
                               asp-controller="Employer" asp-action="Applications">
                                <i class="bi bi-people"></i><span>Başvurular</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Employer" && currentAction == "ProcessManagement" ? "active" : "")"
                               asp-controller="Employer" asp-action="ProcessManagement">
                                <i class="bi bi-diagram-3"></i><span>Süreç Yönetimi</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Employer" && currentAction == "Tasks" ? "active" : "")"
                               asp-controller="Employer" asp-action="Tasks">
                                <i class="bi bi-list-check"></i><span>Görev Yönetimi</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Employer" && currentAction == "DailyLogs" ? "active" : "")"
                               asp-controller="Employer" asp-action="DailyLogs">
                                <i class="bi bi-journal-text"></i><span>Öğrenci Günlükleri</span>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Dashboard" ? "active" : "")"
                               asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-house"></i><span>Ana Sayfa</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Application" ? "active" : "")"
                               asp-controller="Application" asp-action="Index">
                                <i class="bi bi-send"></i><span>Başvurularım</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "DailyLog" ? "active" : "")"
                               asp-controller="DailyLog" asp-action="Index">
                                <i class="bi bi-journal-text"></i><span>Staj Defteri</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "ToDo" ? "active" : "")"
                               asp-controller="ToDo" asp-action="Index">
                                <i class="bi bi-check2-circle"></i><span>Görev Listem</span>
                                @if (pendingTodos > 0)
                                {
                                    <span class="nav-count">@pendingTodos</span>
                                }
                            </a>
                        </li>
                    }
                </ul>

                <div class="nav-section-label mt-4">Hesap</div>
                <ul class="nav flex-column sidebar-nav">
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Profile" ? "active" : "")"
                           asp-controller="Profile" asp-action="Settings">
                            <i class="bi bi-person-gear"></i><span>Profil Ayarları</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="sidebar-footer">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logout">
                        <i class="bi bi-box-arrow-left"></i><span>Çıkış Yap</span>
                    </button>
                </form>
            </div>
        </aside>

        <div class="sidebar-backdrop" data-sidebar-backdrop></div>

        <main class="main-content">
            <header class="top-header">
                <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-label="Menüyü aç veya kapat">
                    <i class="bi bi-list"></i>
                </button>
                <div class="page-heading">
                    <span class="page-kicker">@roleLabel akışı</span>
                    <h1>@pageTitle</h1>
                </div>
                <div class="header-actions">
                    <span class="header-command">
                        <i class="bi bi-activity"></i>
                        <span>Canlı akış</span>
                    </span>
                    @if (!isAdmin && !isSchool && !isEmployer && upcomingInterviews > 0)
                    {
                        <span class="header-pill">
                            <i class="bi bi-calendar-event"></i>
                            @upcomingInterviews mülakat
                        </span>
                    }
                    <span class="header-user">
                        <span class="header-avatar">@userInitial</span>
                        <span>@currentUser?.FullName</span>
                    </span>
                </div>
            </header>

            <div id="premium-toast-container" class="premium-toast-container" aria-live="polite" aria-atomic="true"></div>

            <div class="content-area">
                @RenderBody()
            </div>
        </main>
    </div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        document.querySelectorAll('.modal').forEach(function(modal) {
            document.body.appendChild(modal);
        });

        @if (TempData["Success"] != null)
        {
            <text>window.showPremiumToast?.("success", @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"]?.ToString())));</text>
        }
        @if (TempData["Error"] != null)
        {
            <text>window.showPremiumToast?.("error", @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]?.ToString())));</text>
        }
        @if (TempData["Warning"] != null)
        {
            <text>window.showPremiumToast?.("warning", @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Warning"]?.ToString())));</text>
        }
    });

    window.confirmSubmit = function(form, message) {
        Swal.fire({
            title: 'Onaylıyor musunuz?',
            text: message,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#198754',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Evet, Onayla',
            cancelButtonText: 'İptal',
            background: '#151922',
            color: '#fff',
            customClass: {
                popup: 'rounded-4 border',
            }
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            }
        });
    };
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
